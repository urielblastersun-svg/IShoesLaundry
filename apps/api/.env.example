# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ishoes_laundry?schema=public"

# JWT
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="1d"

# App
PORT=3000
PUBLIC_BASE_URL="http://localhost:3000"
# Prefijo global de rutas (sin barra final). Vacío para desactivarlo.
API_PREFIX="api"

# Storage de fotos: local | gcs
UPLOAD_DRIVER="local"
UPLOAD_DIR="uploads"

# Solo si UPLOAD_DRIVER=gcs
GCS_BUCKET=""
GCS_KEYFILE=""